# ---------------------------------------------------------------
# Template of every environment variable the app needs.
# This file IS committed to git, so NEVER put real values here.
#
# Setup: copy this file to `.env.local` and fill in the values.
# On Vercel, add the same variables under Project → Settings →
# Environment Variables.
# ---------------------------------------------------------------

# --- Database (Neon Postgres) ----------------------------------
# Neon dashboard → your project → Connect → choose the *pooled* connection string.
# Looks like: postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- File storage (Cloudinary) ---------------------------------
# Cloudinary console → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Scheduled jobs --------------------------------------------
# Any long random string. Vercel Cron sends it so only Vercel can trigger the cleanup job.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# --- Building -------------------------------------------------------
# IANA time zone of the hostel. Session times (e.g. 08:00) are in this zone. Default: Asia/Karachi.
# Changing it requires a rebuild/redeploy.
NEXT_PUBLIC_BUILDING_TIMEZONE=Asia/Karachi

# --- Face verification (self-hosted face-api, no account needed) ----
# Optional thresholds (defaults shown). An invalid value BLOCKS self-marking until fixed.
# Max descriptor distance accepted as the same person: 0.3–0.6 (lower = stricter).
FACE_MATCH_MAX_DISTANCE=0.5
# Minimum face-detector confidence: 0.5–0.99.
FACE_MIN_DETECTION_SCORE=0.8

# --- First admin account (used once by `npm run setup`) -----------
# After the admin is created you can delete these three values.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
